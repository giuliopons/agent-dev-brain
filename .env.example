# Copia in .env (chmod 600) e compila. .env non va mai versionato.

# Token di un bot NUOVO da @BotFather
TELEGRAM_TOKEN=
# Il tuo user id Telegram numerico: gli altri vengono ignorati
ALLOWED_USER_ID=

# Auth Claude: uno dei due
# generato con `claude setup-token` (usa l'abbonamento)
CLAUDE_CODE_OAUTH_TOKEN=
# oppure una chiave API (a consumo)
ANTHROPIC_API_KEY=

# Fuso orario per i nomi delle note in inbox/ (default Europe/Rome)
#TZ=Europe/Rome

# uid/gid del tuo utente sull'host (id -u / id -g): li scrive install.sh, default 1000
#AGENT_UID=1000
#AGENT_GID=1000
